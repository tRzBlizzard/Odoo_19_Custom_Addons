<odoo>
    <record id="view_it_asset_equipment_list" model="ir.ui.view">
        <field name="name">it.asset.equipment.list</field>
        <field name="model">it.asset.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment Catalogue">
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="specifications"/>
                <field name="unit_price"/>
            </list>
        </field>
    </record>
    <record id="view_it_asset_equipment_form" model="ir.ui.view">
        <field name="name">it.asset.equipment.form</field>
        <field name="model">it.asset.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="equipment_type"/>
                        <field name="unit_price"/>
                    </group>
                    <group>
                        <field name="specifications"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_asset_equipment" model="ir.actions.act_window">
        <field name="name">Equipment Catalogue</field>
        <field name="res_model">it.asset.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_it_asset_equipment"
            name="Equipment Catalogue"
            parent="menu_it_asset_management_root"
            action="action_it_asset_equipment"
            sequence="20"
    />
</odoo>
