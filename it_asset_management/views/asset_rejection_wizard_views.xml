<odoo>
    <record id="view_asset_rejection_wizard_form" model="ir.ui.view">

        <field name="name">it.asset.rejection.wizard.form</field>

        <field name="model">it.asset.rejection.wizard</field>

        <field name="arch" type="xml">
            <form string="Reject IT Asset Request">

                <group>
                    <field name="request_id" invisible="1"/>

                    <field name="rejection_reason"
                           placeholder="Please explain why this request is being rejected..."/>
                </group>

                <footer>
                    <button name="action_confirm_rejection"
                            string="Confirm Rejection"
                            type="object"
                            class="btn-danger"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>

    </record>
</odoo>