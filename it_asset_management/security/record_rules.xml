
<odoo>

    <!-- IT Asset Users can only see their own requests -->
    <record id="rule_it_asset_request_user_own" model="ir.rule">
        <field name="name">IT Asset User: Own Requests Only</field>
        <field name="model_id" ref="model_it_asset_request"/>
        <field name="groups" eval="[(4, ref('it_asset_management.group_it_asset_user'))]"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
    </record>

    <!-- IT Asset Managers can see all requests -->
    <record id="rule_it_asset_request_manager_all" model="ir.rule">
        <field name="name">IT Asset Manager: All Requests</field>
        <field name="model_id" ref="model_it_asset_request"/>
        <field name="groups" eval="[(4, ref('it_asset_management.group_it_asset_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
