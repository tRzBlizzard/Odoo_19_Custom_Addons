<odoo>
    <record id="report_helpdesk_ticket" model="ir.actions.report">
        <field name="name">Print Ticket</field>
        <field name="model">it.help.desk</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_help_desk.ticket_report</field>
        <field name="report_file">it_help_desk.ticket_report</field>
        <field name="print_report_name">'%s' % (object.ticket_number)</field>
        <!--        <field name="binding_model_id" ref="model_it_help_desk"/>-->
        <!--        <field name="binding_type">report</field>-->
    </record>
    <template id="ticket_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="obj">
                <t t-call="web.external_layout">
                    <div>
                        <div style="position: absolute; top: 20px; right: 20px; z-index: 9999;">
                            <!-- Approved Status (Green) -->
                            <t t-if="obj.status == 'resolved'">
                                <div style="border: 4px solid #198754; color: #198754; font-size: 24px; font-weight: bold; text-transform: uppercase; padding: 10px 20px; border-radius: 5px; transform: rotate(15deg); opacity: 0.85; font-family: sans-serif;">
                                    RESOLVED
                                </div>
                            </t>
                        </div>


                        <h2 class="text-center">IT Help Desk Ticket</h2>
                        <p>
                            <strong>Ticket Number:</strong>
                            <span t-field="obj.ticket_number"/>
                        </p>

