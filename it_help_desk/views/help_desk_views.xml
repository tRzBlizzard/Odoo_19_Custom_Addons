<odoo>
    <record id="view_it_help_desk_list" model="ir.ui.view">
        <field name="name">it.help.desk.list</field>
        <field name="model">it.help.desk</field>
        <field name="arch" type="xml">
            <list string="IT Help Desk">
                <field name="ticket_number"/>
                <field name="request_number"/>
                <field name="requester_id"/>
                <field name="priority"/>
                <field name="assigned_technician"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'raised'"
                       decoration-warning="status == 'in_progress'"
                       decoration-success="status == 'resolved'"
                       decoration-muted="status == 'draft'"
                       decoration-primary="status == 'closed'"/>

            </list>
        </field>
    </record>


    <record id="view_it_help_desk_form" model="ir.ui.view">
        <field name="name">it.help.desk.form</field>
        <field name="model">it.help.desk</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,raised,in_progress,resolved,closed"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="request_number"/>
                            <field name="requester_id"/>
                            <field name="request_title"/>
                            <field name="approver_id"/>
                        </group>
                        <group>
                            <field name="ticket_generated_date"/>
                            <field name="ticket_raised_date"/>
                            <field name="priority"/>
                            <field name="assigned_technician"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Problem Details">
                            <group>
<!--                                <field name="faulty_line_ids"-->
<!--                                       widget="many2many_tags"/>-->
                                <field name="issue_type"/>
                                <field name="description"/>
                            </group>
                        </page>

                    </notebook>



                </sheet>

                <chatter/>


            </form>
        </field>
    </record>


    <!--    MENUS-->
    <record id="action_it_help_desk" model="ir.actions.act_window">
        <field name="name">View Tickets</field>
        <field name="res_model">it.help.desk</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_it_help_desk_root" name="IT Help Desk" sequence="11"/>
    <menuitem id="menu_it_help_desk" name="View Tickets" parent="menu_it_help_desk_root" action="action_it_help_desk"
              sequence="11"/>


</odoo>