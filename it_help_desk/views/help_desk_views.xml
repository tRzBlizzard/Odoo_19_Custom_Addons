<odoo>
    <record id="view_it_help_desk_list" model="ir.ui.view">
        <field name="name">it.help.desk.list</field>
        <field name="model">it.help.desk</field>
        <field name="arch" type="xml">
            <list string="IT Help Desk">
                <field name="ticket_number"/>
                <field name="request_number"/>
                <field name="requester_id"/>
                <field name="priority"/>
                <field name="assigned_technician1"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'raised'"
                       decoration-warning="status == 'in_progress'"
                       decoration-success="status == 'resolved'"
                       decoration-muted="status == 'draft'"
                       decoration-primary="status == 'assigned'"/>

            </list>
        </field>
    </record>


    <record id="view_it_help_desk_form" model="ir.ui.view">
        <field name="name">it.help.desk.form</field>
        <field name="model">it.help.desk</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <button name="action_raise_ticket"
                            string="Raise Ticket"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'draft'"
                            groups="it_asset_management.group_it_asset_user"/>

                    <button name="action_assign"
                            string="Assign"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'raised'"
                            groups="it_asset_management.group_it_asset_manager"/>

                    <button name="action_start_work"
                            string="Accept Ticket"
                            type="object"
                            class="btn-success"
                            invisible="status != 'assigned'"
                            groups="it_help_desk.group_it_technician"/>

                    <button name="action_resolve"
                            string="Resolved"
                            type="object"
                            class="btn-danger"
                            invisible="status != 'in_progress'"
                            groups="it_help_desk.group_it_technician"/>

                    <button name="action_return_to_draft"
                            string="Reset"
                            type="object"
                            class="btn-secondary"/>
<!--                            groups="it_help_desk.group_it_technician"/>-->

                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,raised,in_progress,resolved,assigned"/>
                </header>

                <sheet>
                    <widget name="web_ribbon"
                        title="RESOLVED"
                        bg_color="text-bg-success"
                        invisible="status != 'resolved'"/>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="request_number"/>
                            <field name="requester_id"/>
                            <field name="request_title"/>
                        </group>
                        <group>
                            <field name="ticket_generated_date"/>
                            <field name="ticket_raised_date"/>

                            <field name="ticket_resolve_date" groups="it_help_desk.group_it_technician"/>
                            <field name="ticket_resolve_date" groups="!it_help_desk.group_it_technician" readonly="1"/>

                        </group>

                    </group>
                    <br/>
                    <group>
                        <group>
                            <field name="approver_id"/>
                        </group>
                        <group>
                            <field name="priority" groups="it_asset_management.group_it_asset_manager"/>
                            <field name="priority" groups="!it_asset_management.group_it_asset_manager" readonly="1"/>

                            <field name="assigned_technician1" groups="it_asset_management.group_it_asset_manager"/>
                            <field name="assigned_technician1" groups="!it_asset_management.group_it_asset_manager" readonly="1"/>
                            <!--                            <field name="assigned_technician1"/>-->

                        </group>
                    </group>

                    <notebook>

                        <page string="Problem Details">
                            <group>
                                <!--                                <field name="faulty_line_ids"-->
                                <!--                                       widget="many2many_tags"/>-->
                                <field name="issue_type"/>
                                <field name="description"/>
                            </group>
                        </page>

                        <page string="Resolution Notes">
                            <group>
                                <field name="resolution_notes"
                                       placeholder="Describe the issue, troubleshooting performed, and solution applied..."
                                       groups="!it_help_desk.group_it_technician" readonly="1"/>
                                <field name="resolution_notes"
                                       placeholder="Describe the issue, troubleshooting performed, and solution applied..."
                                       groups="it_help_desk.group_it_technician"/>
                            </group>
                        </page>

                    </notebook>


                </sheet>

                <chatter/>


            </form>
        </field>
    </record>


    <!--    MENUS-->
    <record id="action_it_help_desk" model="ir.actions.act_window">
        <field name="name">View Tickets</field>
        <field name="res_model">it.help.desk</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_it_help_desk_root" name="IT Help Desk" sequence="11"/>
    <menuitem id="menu_it_help_desk" name="View Tickets" parent="menu_it_help_desk_root" action="action_it_help_desk"
              sequence="11"/>


</odoo>