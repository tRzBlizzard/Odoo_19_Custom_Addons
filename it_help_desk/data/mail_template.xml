<odoo>

    <!-- Email to Technician when Ticket is Assigned -->
    <record id="mail_template_it_help_desk_assigned" model="mail.template">

        <field name="name">IT Help Desk - Ticket Assigned</field>

        <field name="model_id" ref="model_it_help_desk"/>

        <field name="auto_delete" eval="False"/>

        <field name="subject">Ticket Assigned: {{object.ticket_number}}</field>

        <field name="email_from">{{ user.email}}</field>

        <field name="email_to">{{object.assigned_technician1.email}}</field>

        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif;">

                <h2>IT Help Desk Ticket Assigned</h2>

                <p>Hello
                    <t t-out="object.assigned_technician1.name"/>,
                </p>

                <p>A new IT Help Desk ticket has been assigned to you.</p>

                <table style="border-collapse: collapse; width: 100%;">
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Ticket Number</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.ticket_number"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Requester</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.requester_id.name"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Priority</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="dict(object._fields['priority'].selection).get(object.priority)"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Issue Type</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.issue_type"/>
                        </td>
                    </tr>
                </table>

                <h3>Problem Description</h3>

                <p>
                    <t t-out="object.description"/>
                </p>

                <p>Please log into Odoo to view the ticket and begin working on it.</p>

                <p>
                    <a t-att-href="object.get_base_url() + '/web#id=%s&amp;model=it.help.desk&amp;view_type=form' % object.id"
                       style="background-color: #714B67;
                       color: white;
                       padding: 10px 18px;
                       text-decoration: none;
                       border-radius: 5px;
                       display: inline-block;">
                        View Help Desk Ticket
                    </a>
                </p>

            </div>
        </field>

    </record>


    <record id="mail_template_it_help_desk_resolved" model="mail.template">

        <field name="name">IT Help Desk - Ticket Resolved</field>

        <field name="model_id" ref="model_it_help_desk"/>

        <field name="auto_delete" eval="False"/>

        <field name="subject">Ticket Assigned: {{object.ticket_number}}</field>

        <field name="email_from">{{user.email}}</field>

        <field name="email_to">{{object.requester_id.email}}</field>

        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif;">

                <h2>IT Help Desk Ticket Resolved!</h2>

                <p>Hello
                    <t t-out="object.requester_id.name"/>,
                </p>

                <p>Your Ticket has been Resolved! Below are the ticket details.</p>

                <table style="border-collapse: collapse; width: 100%;">
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Ticket Number</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.ticket_number"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Requester</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.requester_id.name"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Priority</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="dict(object._fields['priority'].selection).get(object.priority)"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Issue Type</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.issue_type"/>
                        </td>
                    </tr>
                </table>

                <h3>Resolution Notes</h3>

                <p>
                    <t t-out="object.resolution_notes"/>
                </p>

                <p>Please log into Odoo to view more details.</p>


                <p>
                    <a t-att-href="object.get_base_url() + '/web#id=%s&amp;model=it.help.desk&amp;view_type=form' % object.id"
                       style="background-color: #714B67;
                       color: white;
                       padding: 10px 18px;
                       text-decoration: none;
                       border-radius: 5px;
                       display: inline-block;">
                        View Help Desk Ticket
                    </a>
                </p>

            </div>
        </field>

    </record>


</odoo>