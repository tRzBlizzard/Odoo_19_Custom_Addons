<odoo>

    <!-- Email to Technician when Ticket is Assigned -->
    <record id="mail_template_it_help_desk_assigned" model="mail.template">

        <field name="name">IT Help Desk - Ticket Assigned</field>

        <field name="model_id" ref="model_it_help_desk"/>

        <field name="auto_delete" eval="False"/>

        <field name="subject">
            Ticket Assigned: {{ object.ticket_number }}
        </field>

        <field name="email_from">
            {{ user.email or user.company_id.email }}
        </field>

        <field name="email_to">
            {{ object.assigned_technician1.email }}
        </field>

        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif;">

                <h2>IT Help Desk Ticket Assigned</h2>

                <p>Hello
                    <t t-out="object.assigned_technician1.name"/>,
                </p>

                <p>A new IT Help Desk ticket has been assigned to you.</p>

                <table style="border-collapse: collapse; width: 100%;">
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Ticket Number</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.ticket_number"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Requester</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.requester_id.name"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Priority</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.priority"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <strong>Issue Type</strong>
                        </td>
                        <td style="padding: 8px; border: 1px solid #ddd;">
                            <t t-out="object.issue_type"/>
                        </td>
                    </tr>
                </table>

                <h3>Problem Description</h3>

                <p>
                    <t t-out="object.description"/>
                </p>

                <p>Please log into Odoo to view the ticket and begin working on it.</p>

            </div>
        </field>

    </record>

</odoo>